# Database (PostgreSQL)
# Format for local dev: postgresql://<user>:<password>@localhost:5432/<database>
# Format for docker network: postgresql://<user>:<password>@postgres:5432/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sherlog
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://redis:6379/0

# LLM & AI Provider (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_API_KEY=

# Unique shared secret for Alertmanager -> Sherlog incident ingestion.
# Keep the actual value only in the local ignored .env and .secrets/ files.
WEBHOOK_SECRET=
# Required for the protected application network-probe endpoint.
# Generate a unique key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Local Vite development uses this server-side for the loopback-only
# POST /api/applications/{id}/test-connection proxy; no browser storage setup is needed.
# Never expose API_KEY through a VITE_* variable or commit the populated value.
API_KEY=

MAX_STEPS=8
MAX_TOKENS=12000
MAX_SECONDS=120

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Knowledge Base & Vector RAG
RAG_ENABLED=true
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35
