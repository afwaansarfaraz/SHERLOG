# Database (PostgreSQL)
# Format for local dev: postgresql://<user>:<password>@localhost:5432/<database>
# Format for docker network: postgresql://<user>:<password>@postgres:5432/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sherlog
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://redis:6379/0

LLM_API_KEY=

WEBHOOK_SECRET=
API_KEY=

MAX_STEPS=8
MAX_TOKENS=12000
MAX_SECONDS=120

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
